# ── Anthropic API（自有 key）
# 在此填入你的 Anthropic API key（請勿 commit .env）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 選填：自訂 baseURL（自有 Anthropic 官方留空即可）
# ANTHROPIC_BASE_URL=

# ── 模型分工（ADR-009：字串不寫死，可隨時調整）
MODEL_OPUS=claude-opus-4-7
MODEL_SONNET=claude-sonnet-4-6
MODEL_HAIKU=claude-haiku-4-5

# ── 服務設定
PORT=8787
# 允許的前端來源（逗號分隔）。正式環境請填實際域名，勿用 *
# 本機：3000/3100=opportunity-system dev（CRA）；8000=portal 跑 build 版
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:8000
# 是否要求 Authorization（部署正式環境建議 true）
REQUIRE_AUTH=false
FIREBASE_PROJECT_ID=growth-map-main
