{
  "name": "growth-map-workspace",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "workspaces": [
    "packages/*",
    "growthmap/opportunity-system",
    "growthmap/aspiration-case",
    "growthmap/momentum-case",
    "growthmap/evaluate-strategy",
    "growthmap/ido-ai-service"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "preflight": "npm run check:env && npm run check:react && npm test --workspaces --if-present && npm run lint --workspaces --if-present && npm run build --workspaces --if-present",
    "check:react": "node scripts/check-single-react.mjs",
    "check:env": "node scripts/check-preflight-env.mjs",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore --project demo-growth-map-rules \"node --test tests/rules/firestore.rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "body-parser": "^2.4.0",
    "brace-expansion@^1.0.0": "^1.1.21",
    "brace-expansion@^5.0.0": "^5.0.12",
    "dompurify": "^3.4.17",
    "fast-uri": "^3.1.9",
    "js-yaml": "^4.3.2",
    "proxy-addr": "^2.0.8",
    "re2js": "^2.8.7",
    "source-map-js": "^1.2.2",
    "systeminformation": "^5.33.16",
    "undici@^7.0.0": "^7.30.1",
    "undici@^8.0.0": "^8.12.2",
    "vite": "^8.2.4",
    "zod@^4.0.0": "^4.6.6"
  }
}
